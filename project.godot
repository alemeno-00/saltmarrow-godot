; Saltmarrow Deep (Godot rebuild)

config_version=5

[application]

config/name="Saltmarrow Deep"
config/description="A gothic roguelike under a cliff town where a star fell into the sea."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

